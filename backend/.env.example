# Server Configuration
PORT=5001
JWT_SECRET=outbox-lab-super-secret-jwt-key-2026

# Redis Configuration (BullMQ Queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Queue Worker Concurrency & Rate Limiting Settings
WORKER_CONCURRENCY=5
RATE_LIMIT_MAX=10
RATE_LIMIT_DURATION_MS=1000

# Ethereal Email / Custom SMTP Credentials
# Leave SMTP_USER blank to automatically auto-generate a fresh Ethereal test account on startup!
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL="Outbox Scheduler" <no-reply@outbox-lab.internal>

# Demo Auth Credentials
DEMO_USER=admin
DEMO_PASSWORD=password123
